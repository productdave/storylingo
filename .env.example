# The game itself works without an OpenAI key. Add a key to test browser voice.
OPENAI_API_KEY=sk-your-openai-api-key

# Think & Guess uses an AI-led conversational response when an OpenAI key is
# available. Add a saved Responses prompt ID here only if it was created in the
# Chat/Responses editor. Realtime prompt objects are not compatible with this
# text response-writing call. Leave this blank to use the repository prompt.
THINK_GUESS_PROMPT_ID=
THINK_GUESS_PROMPT_VERSION=
THINK_GUESS_RESPONSE_MODEL=gpt-4.1-mini
THINK_GUESS_REALTIME_MODEL=gpt-realtime-2
THINK_GUESS_ENABLE_AI_RESPONSES=true
THINK_GUESS_VOICE=marin

# Keep the local API on IPv4 because macOS may reserve localhost:5000 on IPv6.
EXPO_PUBLIC_DOMAIN=127.0.0.1:5000
